
// ---------------------------------------------------------------------------------------------- 10 · DISPLAY (indicator only)
G_VIS = "7 · Display"
showLevels  = input.bool(true,  "Show entry / stop / targets while in a trade", group = G_VIS)
showSR      = input.bool(true,  "Show support / resistance (confirmed swings)", group = G_VIS)
showStruct  = input.bool(false, "Show BOS / CHoCH markers", group = G_VIS)
showZone    = input.bool(false, "Show demand zone (OHLC-derived)", group = G_VIS)
showDash    = input.bool(true,  "Show dashboard", group = G_VIS)
showRcp     = input.bool(false, "Show Rolling Candle Profile anchor (EMA 21)", group = G_VIS)
dashSize    = input.string("Small", "Dashboard text size", options = ["Tiny", "Small", "Normal"], group = G_VIS)

// BUY / SELL: unmistakable, one marker per decision, placed on the bar where the decision was made (never earlier)
plotshape(buyNow,  "BUY arrow",  shape.triangleup,   location.belowbar, color.new(#00C853, 0), size = size.small)
plotshape(sellNow, "SELL arrow", shape.triangledown, location.abovebar, color.new(#FF1744, 0), size = size.small)
tierTxt = posTier != "" ? " " + posTier : ""
recTxt  = nClosed > 0 ? "\nThis stock: " + str.tostring(nWins) + "/" + str.tostring(nClosed) + " won" : ""
if buyNow
    label.new(bar_index, low - 0.5 * atr, "BUY · " + setupType + tierTxt + "\nLikely win: " + str.tostring(posLikely) +
         "%\n(" + str.tostring(posLikelyN) + " past NSE signals)" + recTxt,
         style = label.style_label_up, color = color.new(#00C853, 0), textcolor = color.white, size = size.small)
if sellNow
    label.new(bar_index, high + 0.5 * atr, "SELL\n" + sellWhy + (na(lastResult) ? "" : "\nResult ≈ " +
         str.tostring(lastResult, "+#.#;-#.#") + "%"), style = label.style_label_down,
         color = color.new(#FF1744, 0), textcolor = color.white, size = size.small)

// Trade levels only while a position is open (breaks between trades, no clutter)
showTrade = showLevels and inPos
plot(showTrade ? entryPx : na, "Entry",          color.new(color.blue, 0),    1, plot.style_linebr)
plot(showTrade ? stopLvl : na, "Stop / trailing", color.new(#FF1744, 0),      2, plot.style_linebr)
plot(showTrade ? tgt1 : na,    "Target 1",       color.new(#00C853, 40),     1, plot.style_linebr)
plot(showTrade ? tgt2 : na,    "Target 2",       color.new(#00C853, 0),      1, plot.style_linebr)
plot(showSR ? swHi : na, "Resistance (last swing high)", color.new(color.orange, 55), 1, plot.style_stepline)
plot(showSR ? swLo : na, "Support (last swing low)",     color.new(color.teal, 55),   1, plot.style_stepline)
plotshape(showStruct and bullBos,   "Bullish BOS",   shape.circle, location.belowbar, color.new(color.green, 40), size = size.tiny)
plotshape(showStruct and bullChoch, "Bullish CHoCH", shape.diamond, location.belowbar, color.new(color.green, 0), size = size.tiny)
plotshape(showStruct and bearBos,   "Bearish BOS",   shape.circle, location.abovebar, color.new(color.red, 40), size = size.tiny)
plotshape(showStruct and bearChoch, "Bearish CHoCH", shape.diamond, location.abovebar, color.new(color.red, 0), size = size.tiny)
plot(showRcp ? rcpAnchor : na, "RCP anchor", color.new(color.purple, 30), 1)
plot(showZone ? dzTop : na, "Demand zone top",    color.new(color.green, 70), 1, plot.style_linebr)
plot(showZone ? dzBot : na, "Demand zone bottom", color.new(color.green, 70), 1, plot.style_linebr)

// ---------------------------------------------------------------------------------------------- 11 · DASHBOARD
txtSize = dashSize == "Tiny" ? size.tiny : dashSize == "Normal" ? size.normal : size.small
var table dash = table.new(position.top_right, 2, 24, bgcolor = color.new(#0D1117, 5), border_color = color.new(#30363D, 0),
     border_width = 1, frame_color = color.new(#30363D, 0), frame_width = 1)
cGood = color.new(#00E676, 0)
cBad  = color.new(#FF5252, 0)
cMid  = color.new(#FFD740, 0)
cTxt  = color.new(#E6EDF3, 0)
cDim  = color.new(#8B949E, 0)

dK(int r, string k) => table.cell(dash, 0, r, k, text_color = cDim, text_size = txtSize, text_halign = text.align_left)
dV(int r, string v, color c) => table.cell(dash, 1, r, v, text_color = c, text_size = txtSize, text_halign = text.align_right)

stockTrend = close > ema50 and ema50 > ema200 ? "BULLISH" : close < ema50 and ema50 < ema200 ? "BEARISH" : "SIDEWAYS"
status = buyNow ? "BUY (next open)" : sellNow ? "SELL (exit)" : inPos ? "HOLD" : score >= minScore ? "WAIT – no trigger yet" :
     score >= 50 ? "WAIT" : "WAIT – avoid fresh entry"
statusCol = buyNow ? cGood : sellNow ? cBad : inPos ? cGood : score >= minScore ? cMid : score >= 50 ? cTxt : cBad
f(x) => "₹" + str.tostring(x, format.mintick)

if showDash and barstate.islast
    table.clear(dash, 0, 0, 1, 23)
    table.cell(dash, 0, 0, "VANTAGE AI", text_color = color.new(#58A6FF, 0), text_size = txtSize, text_halign = text.align_left)
    table.cell(dash, 1, 0, "NSE positional · long-only", text_color = cDim, text_size = txtSize, text_halign = text.align_right)
    dK(1, "Stock")
    dV(1, syminfo.ticker, cTxt)
    dK(2, "Timeframe")
    dV(2, timeframe.period, timeframe.isdaily ? cTxt : cMid)
    dK(3, "Market regime")
    dV(3, mktRegime, mktRegime == "BULLISH" ? cGood : mktRegime == "BEARISH" ? cBad : cMid)
    dK(4, "Stock trend")
    dV(4, stockTrend, stockTrend == "BULLISH" ? cGood : stockTrend == "BEARISH" ? cBad : cMid)
    dK(5, "Momentum")
    dV(5, ptMom >= 12 ? "STRONG" : "WEAK", ptMom >= 12 ? cGood : cBad)
    dK(6, "Relative strength")
    dV(6, not rsKnown ? "N/A" : rsOut ? "OUTPERFORMING" : "UNDERPERFORMING", not rsKnown ? cDim : rsOut ? cGood : cBad)
    dK(7, "Volume")
    dV(7, ptVol >= 6 ? "CONFIRMED" : "WEAK", ptVol >= 6 ? cGood : cBad)
    dK(8, "Market structure")
    dV(8, structDir == 1 ? "BULLISH" : structDir == -1 ? "BEARISH" : "NEUTRAL",
         structDir == 1 ? cGood : structDir == -1 ? cBad : cMid)
    dK(9, "Setup score")
    dV(9, str.tostring(score) + "/100", score >= strongScore ? cGood : score >= minScore ? cMid : score >= 50 ? cTxt : cBad)
    dK(10, "  why")
    dV(10, "Trend " + str.tostring(ptTrend, "#.#") + "/25 · Mom " + str.tostring(ptMom, "#") + "/20 · Str " +
         str.tostring(ptStr, "#") + "/20", cDim)
    dK(11, "")
    dV(11, "RS " + str.tostring(ptRS, "#.#") + "/15 · Vol " + str.tostring(ptVol, "#.#") + "/10 · Mkt " +
         str.tostring(ptMkt, "#") + "/10", cDim)
    dK(12, "Trade status")
    dV(12, status, statusCol)
    r = 13
    if inPos or pendingEntry
        dK(r, "Signal")
        dV(r, setupType + tierTxt + " · likely win " + str.tostring(posLikely) + "%", cGood)
        r += 1
    dK(r, "This stock's record")
    dV(r, nClosed > 0 ? str.tostring(nWins) + " of " + str.tostring(nClosed) + " past signals won" : "no closed signals yet", cDim)
    r += 1
    if inPos or pendingEntry
        dK(r, "Entry")
        dV(r, inPos ? f(entryPx) : "next open ≈ " + f(planEntry), cTxt)
        dK(r + 1, "Stop-loss (initial)")
        dV(r + 1, f(initStop), cBad)
        dK(r + 2, "Stop now (trailing)")
        dV(r + 2, f(stopLvl), cBad)
        dK(r + 3, "Target / exit")
        dV(r + 3, na(tgt1) ? (posType == "Dip-buy" ? "first close above 5-day avg (≈" + f(sma5) + ")" :
             "Rolling Candle Profile SELL") : f(tgt1) + " / " + f(tgt2), cGood)
        dK(r + 4, "Quantity")
        dV(r + 4, str.tostring(posQty) + " shares", cTxt)
        dK(r + 5, "Risk")
        dV(r + 5, "₹" + str.tostring(posQty * (planEntry - initStop), "#,###") + " (" + str.tostring(riskPct) + "%)", cMid)
        if inPos
            pnl = (close / entryPx - 1) * 100
            dK(r + 6, "Unrealised P/L")
            dV(r + 6, str.tostring(pnl, "+#.##;-#.##") + "%", pnl >= 0 ? cGood : cBad)
        r := r + 7
    else
        // calculator for a BUY at today's close with the system's stop (what a trade would look like now)
        inv = qtyCalc * close
        dK(r, "If bought now")
        dV(r, qtyCalc >= 1 ? str.tostring(qtyCalc) + " sh · " + f(inv) : "size < 1 share", cDim)
        dK(r + 1, "Stop / max loss")
        dV(r + 1, f(planStop) + " / ₹" + str.tostring(qtyCalc * riskPS, "#,###"), cDim)
        dK(r + 2, "Reward to T2 · R:R")
        dV(r + 2, "₹" + str.tostring(qtyCalc * t2R * riskPS, "#,###") + " · 1:" + str.tostring(t2R), cDim)
        r := r + 3
    if not chart.is_standard
        dK(r, "⚠ Chart type")
        dV(r, "Use standard candles – signals invalid", cBad)
        r += 1
    if not timeframe.isdaily
        dK(r, "⚠ Timeframe")
        dV(r, "Designed and tested for 1D", cMid)
        r += 1
    if not benchOk
        dK(r, "⚠ Benchmark")
        dV(r, "No data – RS/market neutral", cMid)
        r += 1
    dK(r, "Note")
    dV(r, "Score = confluence, not a probability", cDim)

// ---------------------------------------------------------------------------------------------- 12 · ALERTS
// alertcondition: pick one condition per alert in the TradingView dialog ("Once per bar close").
strongSetup = score >= strongScore and score[1] < strongScore and trendOk and not inPos
crossDown200 = ta.crossunder(close, ema200)
bearDeterioration = bearChoch or crossDown200
alertcondition(buyNow,            "1 · VANTAGE BUY",           "VANTAGE AI BUY {{ticker}} {{interval}} close {{close}} – buy at next open")
alertcondition(buyNow and posType == "Dip-buy", "1a · VANTAGE BUY – Dip-buy only", "VANTAGE AI Dip-buy BUY {{ticker}} close {{close}}")
alertcondition(sellNow,           "2 · VANTAGE SELL",          "VANTAGE AI SELL (exit long) {{ticker}} {{interval}} close {{close}}")
alertcondition(slWarnEvent,       "3 · Stop-loss warning",     "VANTAGE AI stop-loss warning {{ticker}}: price within 0.5 ATR of the stop")
alertcondition(t1Event,           "4 · Target 1 reached",      "VANTAGE AI Target 1 reached {{ticker}} {{interval}}")
alertcondition(t2Event,           "5 · Target 2 reached",      "VANTAGE AI Target 2 reached {{ticker}} {{interval}}")
alertcondition(strongSetup,       "6 · Strong bullish setup",  "VANTAGE AI strong bullish setup forming {{ticker}} (score >= strong level) – no trigger yet")
alertcondition(bearDeterioration, "7 · Bearish deterioration", "VANTAGE AI bearish deterioration {{ticker}} (CHoCH or close below EMA200)")

// One detailed alert with all numbers: create an alert with "Any alert() function call" (fires once per bar close).
if barstate.isconfirmed
    head = syminfo.ticker + " " + timeframe.period + " · close " + str.tostring(close, format.mintick) + " · score " + str.tostring(score)
    if buyNow
        alert("VANTAGE AI BUY (" + setupType + tierTxt + ", likely win " + str.tostring(posLikely) + "% from " +
             str.tostring(posLikelyN) + " past signals) " + head + " · buy next open ≈" + str.tostring(planEntry, format.mintick) +
             " · stop " + str.tostring(initStop, format.mintick) + " · T1 " + str.tostring(tgt1, format.mintick) + " · T2 " +
             str.tostring(tgt2, format.mintick) + " · qty " + str.tostring(posQty) + " · risk ₹" +
             str.tostring(posQty * (planEntry - initStop), "#,###"), alert.freq_once_per_bar_close)
    if sellNow
        alert("VANTAGE AI SELL (exit long) " + head + " · reason: " + sellWhy + (na(lastResult) ? "" : " · result ≈ " +
             str.tostring(lastResult, "+#.#;-#.#") + "%"), alert.freq_once_per_bar_close)
    if slWarnEvent
        alert("VANTAGE AI stop-loss warning " + head + " · stop " + str.tostring(stopLvl, format.mintick), alert.freq_once_per_bar_close)
    if t1Event
        alert("VANTAGE AI Target 1 reached " + head + " · T1 " + str.tostring(tgt1, format.mintick), alert.freq_once_per_bar_close)
    if t2Event
        alert("VANTAGE AI Target 2 reached " + head + " · T2 " + str.tostring(tgt2, format.mintick), alert.freq_once_per_bar_close)
    if strongSetup
        alert("VANTAGE AI strong bullish setup " + head, alert.freq_once_per_bar_close)
    if bearDeterioration
        alert("VANTAGE AI bearish deterioration " + head, alert.freq_once_per_bar_close)
