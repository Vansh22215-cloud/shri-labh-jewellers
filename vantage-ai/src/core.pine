// ============================================================================================================
// ===== CORE BEGIN — identical in VANTAGE_AI_Indicator.pine and VANTAGE_AI_Strategy.pine (generated by build.py)
// ===== Edit src/core.pine and run build.py; never edit the core inside one output file only.
// ============================================================================================================

// ---------------------------------------------------------------------------------------------- 1 · INPUTS
G_CAP = "1 · Capital & risk"
capital     = input.float(50000, "Trading capital (₹)", minval = 1000, step = 1000, group = G_CAP,
     tooltip = "Your trading capital. Used only for the position-size calculator (not your broker balance).")
riskPct     = input.float(1.0, "Risk per trade (%)", minval = 0.1, maxval = 5, step = 0.1, group = G_CAP,
     tooltip = "Money you accept to lose if the stop-loss is hit, as % of capital. 1% is a common professional default.")
maxAllocPct = input.float(25, "Max capital per trade (%)", minval = 1, maxval = 100, step = 1, group = G_CAP,
     tooltip = "Never put more than this share of capital into one stock, even if the stop is very close.")

G_ENT = "2 · Entries"
useBreakout = input.bool(true, "Type 1: Breakout entries", group = G_ENT,
     tooltip = "Trend up + close above the highest high of the lookback period on above-average volume.")
usePullback = input.bool(false, "Type 2: Pullback entries (OFF: failed validation)", group = G_ENT,
     tooltip = "Strong uptrend + dip to the 20-EMA / demand zone on lighter volume + confirmed recovery candle. OFF by " +
     "default: it failed the pre-registered 13-year NSE test (see TEST_RESULTS.md). Switch on only for your own testing.")
useDip      = input.bool(true, "Type 3: Dip-buy (tiered, Vix Fix / WaveTrend / order blocks)", group = G_ENT,
     tooltip = "Strong stock (≥10% above its 200-day average) with an extreme 2-day RSI dip while NIFTY is in an " +
     "uptrend, confirmed by a fear spike and/or a support zone; never during a Squeeze. Exit: first close above the " +
     "5-day average, 4 ATR stop, 10 days max. Does not need the score threshold (its own tested rule).")
useRCP      = input.bool(true, "Type 4: Rolling Candle Profile positional", group = G_ENT,
     tooltip = "Rolling Candle Profile (Zeiierman) BUY within 10% of the 52-week high. Exit: its SELL signal, 5 ATR " +
     "stop, 60 days max. Does not need the score threshold (its own tested rule).")
rcpBars     = input.int(3000, "Rolling Candle Profile: calculate on the last N bars", minval = 300, maxval = 5000,
     group = G_ENT, tooltip = "Heavy calculation. Lower this if TradingView reports a calculation timeout.")
minScore    = input.int(70, "Minimum setup score for BUY (Breakout / Pullback)", minval = 50, maxval = 100, group = G_ENT,
     tooltip = "A BUY also needs a valid setup and all safety filters. The score alone never creates a BUY.")
strongScore = input.int(80, "Strong-setup score", minval = 60, maxval = 100, group = G_ENT)
brkLen      = input.int(50, "Breakout lookback (bars)", minval = 10, maxval = 250, group = G_ENT,
     tooltip = "Resistance = highest high of the previous N bars (the current bar excluded).")
minRvol     = input.float(1.5, "Breakout volume (× 20-day average)", minval = 1.0, maxval = 5, step = 0.1, group = G_ENT)
maxExtAtr   = input.float(3.0, "Not extended: max distance above EMA20 (in ATR)", minval = 1, maxval = 10, step = 0.5,
     group = G_ENT, tooltip = "Blocks buying stocks that have already run far above their 20-EMA.")
minRoomR    = input.float(1.5, "Min room to overhead resistance (in R)", minval = 0, maxval = 10, step = 0.5,
     group = G_ENT, tooltip = "R = entry − stop. Needs this much room before the next resistance (52-week high or a " +
     "confirmed swing high). New 52-week highs have no overhead resistance.")
minGapBars  = input.int(5, "Min bars between an exit and the next BUY", minval = 0, maxval = 100, group = G_ENT)
maxStopPct  = input.float(15, "Skip if the stop is more than X% below entry", minval = 2, maxval = 50, group = G_ENT)

G_EXT = "3 · Exits"
exitMode    = input.string("Fixed risk/reward", "Exit mode", options = ["ATR trailing stop", "Fixed risk/reward", "Combined"],
     group = G_EXT, tooltip = "Fixed risk/reward (default, the only mode that passed the 13-year NSE test): protective " +
     "stop or Target 2.  ATR trailing stop: protective + trailing stop.  Combined: trailing stop + exits on bearish " +
     "deterioration (cut winners too early in testing). See TEST_RESULTS.md.")
atrLen      = input.int(14, "ATR length", minval = 5, maxval = 50, group = G_EXT)
stopMult    = input.float(3.0, "Initial stop (× ATR below entry)", minval = 0.5, maxval = 10, step = 0.25, group = G_EXT)
trailMult   = input.float(4.0, "Trailing stop (× ATR below the highest high since entry)", minval = 0.5, maxval = 10,
     step = 0.25, group = G_EXT, tooltip = "The stop only ever moves UP.")
t1R         = input.float(2.0, "Target 1 (× R)", minval = 0.5, maxval = 10, step = 0.5, group = G_EXT)
t2R         = input.float(3.0, "Target 2 (× R)", minval = 1.0, maxval = 20, step = 0.5, group = G_EXT)

G_MKT = "4 · Market & benchmark"
benchSym    = input.symbol("NSE:NIFTY", "Benchmark index", group = G_MKT,
     tooltip = "Used for relative strength and the market regime. NSE:NIFTY = NIFTY 50.")
useMarket   = input.bool(true, "Market filter: no fresh BUY when the benchmark is BEARISH", group = G_MKT)

G_STR = "5 · Structure"
swingLen    = input.int(5, "Swing length (bars on each side)", minval = 2, maxval = 20, group = G_STR,
     tooltip = "A swing high/low is confirmed only after this many later bars. It is never drawn or used earlier.")

G_W = "6 · Score weights (normalised to 100)"
wTrend = input.float(25, "Trend quality", minval = 0, group = G_W)
wMom   = input.float(20, "Momentum", minval = 0, group = G_W)
wStr   = input.float(20, "Market structure & price action", minval = 0, group = G_W)
wRS    = input.float(15, "Relative strength", minval = 0, group = G_W)
wVol   = input.float(10, "Volume confirmation", minval = 0, group = G_W)
wMkt   = input.float(10, "Market regime", minval = 0, group = G_W)

// ---------------------------------------------------------------------------------------------- 2 · BASE SERIES
atr     = ta.atr(atrLen)
ema20   = ta.ema(close, 20)
ema50   = ta.ema(close, 50)
ema200  = ta.ema(close, 200)
rsi     = ta.rsi(close, 14)
[macdLine, macdSig, hist] = ta.macd(close, 12, 26, 9)
[diPlus, diMinus, adx]    = ta.dmi(14, 14)
volAvg  = ta.sma(volume, 20)[1]                         // average of the 20 PREVIOUS bars
rvol    = volAvg > 0 ? volume / volAvg : na
hiPrior = ta.highest(high, brkLen)[1]                   // resistance: previous N bars, current bar excluded
hi252   = ta.highest(high, 252)[1]                      // 52-week high, current bar excluded

// Higher timeframe: ONLY the previous, fully completed weekly candle ([1] + lookahead_on = no repainting).
[wClose, wEma, wEmaPrev] = request.security(syminfo.tickerid, "W", [close[1], ta.ema(close, 20)[1], ta.ema(close, 20)[2]],
     lookahead = barmerge.lookahead_on)
weeklyKnown = not na(wEma) and not na(wEmaPrev)
weeklyUp    = weeklyKnown and wClose > wEma and wEma > wEmaPrev

// Benchmark (same timeframe, no lookahead). Missing / invalid symbol -> na -> modules fall back to neutral.
[bClose, bEma50, bEma200, bSma200, bRsi2] = request.security(benchSym, timeframe.period,
     [close, ta.ema(close, 50), ta.ema(close, 200), ta.sma(close, 200), ta.rsi(close, 2)], ignore_invalid_symbol = true)
benchOk = not na(bClose) and not na(bEma200) and bClose > 0

// ---------------------------------------------------------------------------------------------- 3 · RELATIVE STRENGTH
rs      = benchOk ? close / bClose : na
rsPerf  = rs / rs[63] - 1                               // 3-month performance vs the benchmark
rsSma   = ta.sma(rs, 50)
rsEma   = ta.ema(rs, 10)
rsKnown = not na(rsPerf) and not na(rsSma) and not na(rsEma[10])
rsOut   = rsKnown and rsPerf > 0 and rs > rsSma         // OUTPERFORMING
rsImproving = rsKnown and rsEma > rsEma[10]

// ---------------------------------------------------------------------------------------------- 4 · MARKET REGIME
mktBull   = benchOk and bClose > bEma200 and bEma50 > bEma200
mktBear   = benchOk and bClose < bEma200 and bEma50 < bEma200
mktRegime = not benchOk ? "N/A" : mktBull ? "BULLISH" : mktBear ? "BEARISH" : "SIDEWAYS"

// ---------------------------------------------------------------------------------------------- 5 · MARKET STRUCTURE
// Swings are confirmed swingLen bars later and only USED from that bar on (never back-dated).
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float swHi     = na
var float swHiPrev = na
var float swLo     = na
var float swLoPrev = na
var bool  hiTaken  = false
var bool  loTaken  = false
var int   structDir = 0                                  // 1 bullish, -1 bearish, 0 not yet known
var float dzTop = na                                     // "demand zone": last down candle before a bullish break
var float dzBot = na                                     // (an OHLC-derived zone, NOT actual institutional orders)
if not na(ph)
    swHiPrev := swHi
    swHi     := ph
    hiTaken  := false
if not na(pl)
    swLoPrev := swLo
    swLo     := pl
    loTaken  := false
bullBreak = not na(swHi) and not hiTaken and close > swHi
bearBreak = not na(swLo) and not loTaken and close < swLo
bullChoch = bullBreak and structDir == -1
bullBos   = bullBreak and structDir != -1
bearChoch = bearBreak and structDir == 1
bearBos   = bearBreak and structDir != 1
if bullBreak
    hiTaken   := true
    structDir := 1
    for i = 1 to 10
        if close[i] < open[i]
            dzTop := high[i]
            dzBot := low[i]
            break
if bearBreak
    loTaken   := true
    structDir := -1
if not na(dzBot) and close < dzBot
    dzTop := na
    dzBot := na
higherLow = not na(swLo) and not na(swLoPrev) and swLo > swLoPrev

// Failed breakout: a close back below a level broken in the last 3 bars.
var float brkLevel = na
var int   brkBar   = na
failedBreakout = not na(brkLevel) and bar_index - brkBar <= 3 and bar_index > brkBar and close < brkLevel
if failedBreakout or (not na(brkBar) and bar_index - brkBar > 3)
    brkLevel := na
    brkBar   := na
newBreak = close > hiPrior and close[1] <= hiPrior[1]
if newBreak
    brkLevel := hiPrior
    brkBar   := bar_index
recentFailed = nz(ta.barssince(failedBreakout), 999) <= 5

// Rejection: long upper wick into a resistance level, close back below it.
upperWick = high - math.max(open, close)
body      = math.abs(close - open)
nearRes   = (not na(swHi) and high >= swHi * 0.995 and close < swHi) or (not na(hi252) and high >= hi252 * 0.995 and close < hi252)
rejection = upperWick >= 2 * body and upperWick >= 0.5 * atr and nearRes

// ---------------------------------------------------------------------------------------------- 6 · SCORE (0-100)
// Each module is capped at its own weight, so correlated indicators inside one module cannot inflate the total.
ptTrend = (close > ema20 ? 5.0 : 0.0) + (ema20 > ema50 ? 5.0 : 0.0) + (ema50 > ema200 ? 5.0 : 0.0) +
     (ema50 > ema50[10] ? 2.5 : 0.0) + (ema200 > ema200[20] ? 2.5 : 0.0) + (weeklyKnown ? (weeklyUp ? 5.0 : 0.0) : 2.5)
ptMom = (rsi >= 50 and rsi <= 70 ? 8.0 : rsi > 70 and rsi <= 78 ? 4.0 : rsi >= 45 and rsi < 50 ? 3.0 : 0.0) +
     (hist > 0 and hist > hist[1] ? 6.0 : hist > 0 ? 4.0 : hist > hist[1] and hist[1] > hist[2] ? 2.0 : 0.0) +
     (adx >= 20 and diPlus > diMinus ? 6.0 : diPlus > diMinus ? 3.0 : 0.0)
ptStr = math.max(0.0, (structDir == 1 ? 8.0 : structDir == 0 ? 4.0 : 0.0) + (higherLow ? 6.0 : 0.0) +
     (nz(ta.barssince(bullBreak), 999) <= 15 ? 6.0 : 0.0) - (recentFailed ? 6.0 : 0.0) - (rejection ? 4.0 : 0.0))
ptRS = rsKnown ? (rsPerf > 0 ? 5.0 : 0.0) + (rs > rsSma ? 5.0 : 0.0) + (rsImproving ? 5.0 : 0.0) : 7.5
upVol   = math.sum(close > close[1] ? volume : 0.0, 20)
dnVol   = math.sum(close < close[1] ? volume : 0.0, 20)
accRatio = dnVol > 0 ? upVol / dnVol : 2.0
vol10 = ta.sma(volume, 10)
vol50 = ta.sma(volume, 50)
riseWeak = close > close[10] and vol10 < 0.8 * vol50
ptVol = math.max(0.0, (accRatio >= 1.2 ? 5.0 : accRatio >= 1.0 ? 2.5 : 0.0) +
     (close > close[1] and nz(rvol) >= 1.5 ? 5.0 : close > close[1] and nz(rvol) < 0.7 ? 0.0 : 2.5) - (riseWeak ? 2.5 : 0.0))
ptMkt = benchOk ? (bClose > bEma200 ? 5.0 : 0.0) + (bEma50 > bEma200 ? 5.0 : 0.0) : 5.0

wSum  = wTrend + wMom + wStr + wRS + wVol + wMkt
wNorm = wSum > 0 ? 100.0 / wSum : 0.0
score = math.round((wTrend * ptTrend / 25 + wMom * ptMom / 20 + wStr * ptStr / 20 + wRS * ptRS / 15 +
     wVol * ptVol / 10 + wMkt * ptMkt / 10) * wNorm)

// ---------------------------------------------------------------------------------------------- 7 · SETUPS
trendOk = close > ema200 and ema50 > ema200 and close > ema50
rsOkBrk = not rsKnown or rsPerf > 0 or rs > rsSma
rsOkPb  = not rsKnown or rs > rsSma
breakoutSetup = useBreakout and trendOk and newBreak and nz(rvol) >= minRvol and (hist > 0 or rsi > 55) and rsOkBrk
stackUp  = ema20 > ema50 and ema50 > ema200 and ema50 > ema50[10]
low5     = ta.lowest(low, 5)
touched  = low5 <= ema20 * 1.005 or (not na(dzTop) and low5 <= dzTop and close > dzBot)
held     = ta.lowest(close, 5) >= ema50 * 0.98
rsiLow5  = ta.lowest(rsi, 5)
rsiCool  = rsiLow5 <= 55 and rsiLow5 >= 38
volDry   = ta.sma(volume, 3)[1] < volAvg
recovery = close > high[1] and close > open and close > ema20
pullbackSetup = usePullback and stackUp and touched and held and rsiCool and volDry and recovery and rsOkPb

// ---------------------------------------------------------------------------------------------- 8 · RISK & FILTERS
planStop = close - stopMult * atr
riskPS   = close - planStop
stopOk   = riskPS > 0 and riskPS / close * 100 <= maxStopPct
float overhead = na
if not na(hi252) and close < hi252
    overhead := hi252
if not na(swHi) and swHi > close
    overhead := na(overhead) ? swHi : math.min(overhead, swHi)
roomOk      = na(overhead) or overhead - close >= minRoomR * riskPS
notExtended = close - ema20 <= maxExtAtr * atr and rsi <= 80
mktOk       = not useMarket or not mktBear
riskAmt  = capital * riskPct / 100
qtyRisk  = riskPS > 0 ? math.floor(riskAmt / riskPS) : 0
qtyCap   = close > 0 ? math.floor(capital * maxAllocPct / 100 / close) : 0
qtyCalc  = math.min(qtyRisk, qtyCap)
warm     = bar_index >= 260 and not na(ema200) and not na(atr)

// ---------------------------------------------------------------------------------------------- 8b · DIP-BUY CONFIRMATIONS
// Rebuilt from the original open-source scripts with their default settings and tested on 13 years of NSE data:
// CM Williams Vix Fix (ChrisMoody), WaveTrend (LazyBear), Squeeze (LazyBear), Market Structure Break & Order Block
// (EmreKb), order blocks and swing-low hold. SuperTrend / HTF sweep-CISD / AVPT were tested too and are NOT used
// (they did not improve or worsened the signals).
clampf(float x, float lo, float hi) => math.min(hi, math.max(lo, x))
// No multi-line functions anywhere (TradingView's mobile editor re-indents the lines after a '=>' when pasting).
// Every ta.* call is evaluated on every bar (Pine v6 'and'/'or' are lazy, so none sits on their right side).
// Pivot = the bar n back is the highest (lowest) of the 2n+1 window and strictly above (below) the n bars before it.
lAll5  = ta.lowest(low, 11)
lLeft5 = ta.lowest(low, 5)[6]
hAll9  = ta.highest(high, 19)
hLeft9 = ta.highest(high, 9)[10]
lAll9  = ta.lowest(low, 19)
lLeft9 = ta.lowest(low, 9)[10]

atrS   = ta.sma(ta.tr(true), 14)                         // ATR as a simple average (as tested for types 3 and 4)
sma5   = ta.sma(close, 5)
sma200 = ta.sma(close, 200)
rsi2   = ta.rsi(close, 2)
// Vix Fix fear spike in the last 3 bars
vfHc    = ta.highest(close, 22)
wvf     = (vfHc - low) / vfHc * 100
vfUp    = ta.sma(wvf, 20) + 2 * ta.stdev(wvf, 20)
vfMax50 = ta.highest(wvf, 50)
vfGreen = wvf >= vfUp or wvf >= vfMax50 * 0.85
fear    = nz(ta.barssince(vfGreen), 99) <= 2
// WaveTrend oversold
wtAp  = hlc3
wtEsa = ta.ema(wtAp, 10)
wtD   = ta.ema(math.abs(wtAp - wtEsa), 10)
wtCi  = na(wtD) or wtD == 0 ? 0.0 : (wtAp - wtEsa) / (0.015 * wtD)
wtOversold = ta.ema(wtCi, 21) < -53
// Squeeze ON (Bollinger inside Keltner): dip-buys fail here
sqBasis = ta.sma(close, 20)
sqDev   = 2 * ta.stdev(close, 20)
sqRng   = ta.sma(ta.tr(true), 20)
sqzOn   = sqBasis - sqDev > sqBasis - 1.5 * sqRng and sqBasis + sqDev < sqBasis + 1.5 * sqRng
// Swing-low hold (5-bar pivots, used only after confirmation)
isPL5 = low[5] == lAll5 and low[5] < lLeft5
var float pl5 = na
if isPL5
    pl5 := low[5]
rmaTr = ta.rma(ta.tr(true), 14)
slHoldBar = not na(pl5) and low <= pl5 + 0.1 * rmaTr and close > pl5 and close > open
slHold = nz(ta.barssince(slHoldBar), 99) <= 4
// Market Structure Break & Order Block (9-bar pivots, 0.33 break)
isPH9 = high[9] == hAll9 and high[9] > hLeft9
isPL9 = low[9] == lAll9 and low[9] < lLeft9
var float ph9 = na
var float pl9 = na
var int   pl9Bar = na
if isPH9
    ph9 := high[9]
if isPL9
    pl9    := low[9]
    pl9Bar := bar_index - 9
var float mobLo  = na
var float mobHi  = na
var int   mobBar = na
msbTouchBar = false
if not na(ph9) and not na(pl9)
    rngM = ph9 - pl9
    if close > ph9 + 0.33 * rngM and close[1] <= ph9[1] + 0.33 * rngM
        off = bar_index - pl9Bar
        lim = math.min(bar_index, off + 400)
        for j = off to lim
            off := j
            if close[j] < open[j]
                break
        mobLo  := low[off]
        mobHi  := high[off]
        mobBar := bar_index
if not na(mobBar) and bar_index > mobBar and low <= mobHi
    msbTouchBar := close >= mobLo
    mobLo  := na
    mobHi  := na
    mobBar := na
msbOB = nz(ta.barssince(msbTouchBar), 99) <= 4
// Order blocks: last down candle before a ≥1.5 ATR up-move that breaks the 10-day high; first return = touch
var array<float> zLo = array.new<float>()
var array<float> zHi = array.new<float>()
var array<int>   zSt = array.new<int>()
obTouchBar = false
if array.size(zLo) > 0
    for z = array.size(zLo) - 1 to 0
        if bar_index >= array.get(zSt, z) + 60
            array.remove(zLo, z)
            array.remove(zHi, z)
            array.remove(zSt, z)
        else if bar_index >= array.get(zSt, z) and low <= array.get(zHi, z)
            if close >= array.get(zLo, z)
                obTouchBar := true
            array.remove(zLo, z)
            array.remove(zHi, z)
            array.remove(zSt, z)
best3 = math.max(close, close[1], close[2])
hi10Before = ta.highest(high, 10)[4]
if close[3] < open[3] and not na(atrS[3]) and best3 - high[3] >= 1.5 * atrS[3] and best3 > hi10Before
    array.push(zLo, low[3])
    array.push(zHi, high[3])
    array.push(zSt, bar_index + 1)
obTouch = nz(ta.barssince(obTouchBar), 99) <= 2
zoneAny = obTouch or wtOversold or msbOB or slHold
dipBase  = close >= 1.10 * sma200 and rsi2 < 2 and benchOk and bClose > bSma200 and bRsi2 < 20
dipSetup = useDip and dipBase and not sqzOn and (fear or zoneAny)
dipTier  = fear and zoneAny ? "A" : fear ? "B" : "C"

// ---------------------------------------------------------------------------------------------- 8c · ROLLING CANDLE PROFILE
// Rolling Candle Profile with Buy/Sell Signals - (c) Zeiierman, CC BY-NC-SA 4.0. Price-pressure mode, default inputs
// (EMA 21 anchor, 12 bands, 60 bars, width 0.01, wick 0.85, dominance 0.25, 7 bands, 6-bar spacing). Port of the
// tested Python port (swing-system/swing/rolling_profile.py). Personal, non-commercial use.
kern(float here, float center, float iw) => math.pow(math.max(0.0, 1.0 - math.abs(here - center) * iw), 2) * (3.0 - 2.0 * math.max(0.0, 1.0 - math.abs(here - center) * iw))
rcpTick   = syminfo.mintick
rcpAnchor = ta.ema(close, 21)
rcpR      = math.max(high - low, rcpTick)
rcpPc     = nz(close[1], open)
rcpDir    = clampf((close - open) / rcpR, -1, 1)
rcpTravel = clampf((close - rcpPc) / rcpR, -1.5, 1.5)
rcpLoc    = clampf((2 * close - high - low) / rcpR, -1, 1)
rcpResp   = clampf(0.55 * rcpTravel + 0.25 * rcpDir + 0.20 * rcpLoc, -1.5, 1.5)
rcpForce  = math.abs(rcpResp)
rcpPrior  = nz(rcpPc - close[2])
rcpCont   = rcpPrior * rcpResp > 0 ? 1.45 : rcpPrior * rcpResp < 0 ? 0.55 : 1.0
rcpBuyRaw = math.max(rcpResp, 0) * (1 + rcpForce * 1.25) * rcpCont * 2
rcpSelRaw = math.max(-rcpResp, 0) * (1 + rcpForce * 1.25) * rcpCont * 2
rcpLowRaw = math.max(0, math.min(open, close) - low) / rcpR * (0.35 + 1.2 * math.max(rcpResp, 0))
rcpHiRaw  = math.max(0, high - math.max(open, close)) / rcpR * (0.35 + 1.2 * math.max(-rcpResp, 0))
rcpStall  = (1 - clampf(rcpForce, 0, 1)) * 0.20
rcpTot    = rcpBuyRaw + rcpSelRaw + rcpLowRaw + rcpHiRaw + rcpStall
rcpBase   = ta.ema(rcpTot, 55)
rcpScale  = rcpTot > 0 ? math.min(1.0, math.max(rcpBase, 1e-6) * 20 / rcpTot) : 1.0
rcpB  = rcpBuyRaw * rcpScale
rcpS  = rcpSelRaw * rcpScale
rcpLR = rcpLowRaw * rcpScale
rcpHR = rcpHiRaw * rcpScale
rcpBC = rcpBuyRaw > 0 ? close * 0.7 + high * 0.3 : hlc3
rcpSC = rcpSelRaw > 0 ? close * 0.7 + low * 0.3 : hlc3
rcpLC = rcpLowRaw > 0 ? (low + math.min(open, close)) * 0.5 : low
rcpHC = rcpHiRaw > 0 ? (high + math.max(open, close)) * 0.5 : high
rcpBW  = math.max(high - low, rcpTick) * 0.01
rcpBWW = rcpBW * 0.6
bodyLo = math.min(open, close)
bodyHi = math.max(open, close)
rcpEdge = rcpAnchor < bodyLo ? bodyLo : rcpAnchor > bodyHi ? bodyHi : na
rcpRising  = rcpAnchor > rcpAnchor[1]
rcpFalling = rcpAnchor < rcpAnchor[1]
int   rcpVis = 0
int   rcpBB  = 0
int   rcpSB  = 0
float rcpPB  = 0.0
float rcpPS  = 0.0
if bar_index >= 62 and last_bar_index - bar_index < rcpBars and not na(rcpEdge) and math.abs(rcpEdge - rcpAnchor) > 2 * rcpTick and
     ((close > rcpAnchor and rcpRising) or (close < rcpAnchor and rcpFalling))
    dist  = (rcpEdge - rcpAnchor) / 12
    minW  = math.abs(dist) * 1.15
    minWk = math.abs(dist) * 1.00
    volB  = math.max(1e-6, rcpBase)
    for bnd = 0 to 11
        here = rcpAnchor + dist * (bnd + 0.5)
        bf = 0.0
        sf = 0.0
        for k = 0 to 59
            age = math.pow(0.5, k / 3.0)
            iw  = 1.0 / math.max(math.max(rcpBW[k], minW), rcpTick)
            iww = 1.0 / math.max(math.max(rcpBWW[k], minWk), rcpTick)
            bf += (rcpB[k] * kern(here, rcpBC[k], iw) + 0.85 * rcpLR[k] * kern(here, rcpLC[k], iww)) * age
            sf += (rcpS[k] * kern(here, rcpSC[k], iw) + 0.85 * rcpHR[k] * kern(here, rcpHC[k], iww)) * age
        tot = bf + sf
        imb = tot > 0 ? clampf((bf - sf) / tot * 3, -1, 1) : 0.0
        act = clampf(tot / (volB * 0.80), 0, 1)
        if act >= 0.08 and math.abs(imb) >= 0.14
            rcpVis += 1
            rcpBB  += imb > 0.03 ? 1 : 0
            rcpSB  += imb < -0.03 ? 1 : 0
            rcpPB  += bf
            rcpPS  += sf
rcpPTot = rcpPB + rcpPS
rcpBias = rcpPTot > 0 ? (rcpPB - rcpPS) / rcpPTot : 0.0
rcpHas  = rcpVis >= 7 and rcpPTot > 0
rcpBull = rcpHas and rcpBias >= 0.25 and rcpBB > rcpSB and close > rcpAnchor and rcpRising
rcpBear = rcpHas and rcpBias <= -0.25 and rcpSB > rcpBB and close < rcpAnchor and rcpFalling
var int rcpLastB = -1000000
var int rcpLastS = -1000000
rcpBuy = false
rcpSell = false
if rcpBull and not rcpBull[1] and bar_index - rcpLastB >= 6
    rcpBuy   := true
    rcpLastB := bar_index
if rcpBear and not rcpBear[1] and bar_index - rcpLastS >= 6
    rcpSell  := true
    rcpLastS := bar_index
hiClose250 = ta.highest(close, 250)
rcpSetup = useRCP and rcpBuy and close >= 0.9 * hiClose250

// Historical win rate (after costs) of similar signals in the 13-year NSE test - a past frequency, not a promise.
likelyPct(string typ, string tier, int sc) => typ == "Dip-buy" ? (tier == "A" ? __DIP_A__ : tier == "B" ? __DIP_B__ : __DIP_C__) : typ == "RCP" ? __RCP__ : typ == "Breakout" ? (sc >= 90 ? __BRK_90__ : sc >= 80 ? __BRK_80__ : __BRK_70__) : __PB__
likelyN(string typ, string tier, int sc) => typ == "Dip-buy" ? (tier == "A" ? __N_DIP_A__ : tier == "B" ? __N_DIP_B__ : __N_DIP_C__) : typ == "RCP" ? __N_RCP__ : typ == "Breakout" ? (sc >= 90 ? __N_BRK_90__ : sc >= 80 ? __N_BRK_80__ : __N_BRK_70__) : __N_PB__

// ---------------------------------------------------------------------------------------------- 9 · POSITION STATE
// One simulated long position. Everything below changes ONLY on confirmed (closed) bars.
var bool   inPos        = false
var bool   pendingEntry = false
var bool   pendingExit  = false
var string pendingWhy   = ""
var string setupType    = ""
var float  planEntry    = na
var float  entryPx      = na
var float  initStop     = na
var float  stopLvl      = na
var float  tgt1         = na
var float  tgt2         = na
var float  hiSince      = na
var int    entryBar     = na
var int    lastExitBar  = -100000
var int    posQty       = 0
var int    entryScore   = 0
var bool   t1Done       = false
var bool   t2Done       = false
var bool   slWarned     = false
var string posType      = ""
var string posTier      = ""
var int    posLikely    = 0
var int    posLikelyN   = 0
var int    nClosed      = 0
var int    nWins        = 0
float lastResult = na
buyNow   = false
sellNow  = false                     // a SELL decision was made on this bar
string sellWhy = ""
exitFill = false                     // the position was closed during this bar (stop/target) or at its open
float exitPx = na
t1Event  = false
t2Event  = false
slWarnEvent = false
if barstate.isconfirmed and warm
    // a) exit decided on the previous bar -> filled at this bar's open
    if inPos and pendingExit
        inPos       := false
        pendingExit := false
        exitFill    := true
        exitPx      := open
        lastExitBar := bar_index
        nClosed     += 1
        nWins       += open > entryPx * 1.0035 ? 1 : 0
    // b) entry decided on the previous bar -> filled at this bar's open
    if pendingEntry
        pendingEntry := false
        inPos    := true
        entryPx  := open
        entryBar := bar_index
        hiSince  := high
        t1Done   := false
        t2Done   := false
        slWarned := false
    // c) protective / trailing stop and fixed target inside this bar (stop checked first: conservative)
    if inPos
        if low <= stopLvl
            inPos       := false
            exitFill    := true
            exitPx      := math.min(open, stopLvl)
            nClosed     += 1
            nWins       += exitPx > entryPx * 1.0035 ? 1 : 0
            lastResult  := (exitPx / entryPx - 1) * 100
            sellNow     := true
            sellWhy     := stopLvl > initStop ? "Trailing stop" : "Stop-loss"
            lastExitBar := bar_index
        else if (posType == "Breakout" or posType == "Pullback") and exitMode == "Fixed risk/reward" and high >= tgt2
            inPos       := false
            exitFill    := true
            exitPx      := math.max(open, tgt2)
            nClosed     += 1
            nWins       += exitPx > entryPx * 1.0035 ? 1 : 0
            lastResult  := (exitPx / entryPx - 1) * 100
            sellNow     := true
            sellWhy     := "Target 2"
            lastExitBar := bar_index
    // d) still in the position: target events, trailing stop (only up), bearish deterioration
    if inPos
        if not t1Done and high >= tgt1
            t1Done  := true
            t1Event := true
        if not t2Done and high >= tgt2
            t2Done  := true
            t2Event := true
        hiSince := math.max(hiSince, high)
        if (posType == "Breakout" or posType == "Pullback") and exitMode != "Fixed risk/reward"
            stopLvl := math.max(stopLvl, hiSince - trailMult * atr)
        if not slWarned and close <= stopLvl + 0.5 * atr
            slWarned    := true
            slWarnEvent := true
        string tw = ""
        if posType == "Dip-buy"
            tw := close > sma5 ? "Closed above the 5-day average (dip-buy exit)" : bar_index - entryBar >= 9 ? "Time exit (10 days)" : ""
        else if posType == "RCP"
            tw := rcpSell ? "Rolling Candle Profile SELL" : bar_index - entryBar >= 59 ? "Time exit (60 days)" : ""
        if tw != ""
            pendingExit := true
            pendingWhy  := tw
            sellNow     := true
            sellWhy     := tw
            lastResult  := (close / entryPx - 1) * 100
        if (posType == "Breakout" or posType == "Pullback") and exitMode == "Combined"
            string why = ""
            if close < ema50 and hist < 0
                why := "Trend deterioration (below EMA50, MACD negative)"
            else if bearChoch
                why := "Bearish structure change (CHoCH)"
            else if bearBos and close < ema20
                why := "Support breakdown (bearish BOS)"
            else if failedBreakout and bar_index - entryBar <= 5
                why := "Failed breakout"
            if why != ""
                pendingExit := true
                pendingWhy  := why
                sellNow     := true
                sellWhy     := why
                lastResult  := (close / entryPx - 1) * 100
    // e) new BUY (decided at the close, filled at the next open). Priority = best tested record first.
    gapOk = bar_index - lastExitBar >= minGapBars
    if not inPos and not pendingEntry and gapOk
        string pick = ""
        float  ps   = na
        if dipSetup and atrS > 0
            pick := "Dip-buy"
            ps   := close - 4.0 * atrS
        else if rcpSetup and atrS > 0
            pick := "RCP"
            ps   := close - 5.0 * atrS
        else if (breakoutSetup or pullbackSetup) and notExtended and stopOk and roomOk and mktOk and not rejection and
             score >= minScore
            pick := breakoutSetup ? "Breakout" : "Pullback"
            ps   := planStop
        if pick != ""
            rps = close - ps
            q   = math.min(rps > 0 ? math.floor(riskAmt / rps) : 0, qtyCap)
            if q >= 1
                pendingEntry := true
                buyNow       := true
                setupType    := pick == "RCP" ? "Rolling Candle Profile" : pick
                posType      := pick
                posTier      := pick == "Dip-buy" ? dipTier : ""
                planEntry    := close
                initStop     := ps
                stopLvl      := ps
                tgt1         := pick == "Breakout" or pick == "Pullback" ? close + t1R * rps : na
                tgt2         := pick == "Breakout" or pick == "Pullback" ? close + t2R * rps : na
                posQty       := q
                entryScore   := int(score)
                posLikely    := likelyPct(pick, posTier, entryScore)
                posLikelyN   := likelyN(pick, posTier, entryScore)
// ============================================================================================================
// ===== CORE END
// ============================================================================================================
