
// ---------------------------------------------------------------------------------------------- 10 · ORDERS (strategy only)
// The strategy places orders EXACTLY where the shared core decides:
//   BUY decided at the close  -> strategy.entry fills at the next bar's open (process_orders_on_close = false)
//   protective / trailing stop -> strategy.exit stop order, re-sent each bar with the core's current stop
//   Fixed risk/reward mode     -> strategy.exit limit at Target 2
//   deterioration SELL         -> strategy.close at the close -> fills at the next bar's open
if barstate.isconfirmed and warm
    if buyNow
        strategy.entry("Long", strategy.long, qty = posQty, comment = setupType + " " + str.tostring(entryScore))
    if (inPos or pendingEntry) and not pendingExit
        strategy.exit("Stop/Target", "Long", stop = stopLvl, limit = exitMode == "Fixed risk/reward" ? tgt2 : na,
             comment_loss = "Stop", comment_profit = "Target 2")
    if pendingExit and sellNow
        strategy.close("Long", comment = sellWhy)

plotshape(buyNow,  "BUY",  shape.triangleup,   location.belowbar, color.new(#00C853, 0), size = size.small)
plotshape(sellNow, "SELL", shape.triangledown, location.abovebar, color.new(#FF1744, 0), size = size.small)
plot(inPos ? stopLvl : na, "Stop / trailing", color.new(#FF1744, 0), 2, plot.style_linebr)

// Consistency check shown on the chart: trades simulated by the core vs trades filled by TradingView's broker emulator.
var int coreTrades = 0
if exitFill
    coreTrades += 1
var table chk = table.new(position.bottom_right, 2, 3, bgcolor = color.new(#0D1117, 5))
if barstate.islast
    table.cell(chk, 0, 0, "Core trades closed", text_color = color.gray, text_size = size.small)
    table.cell(chk, 1, 0, str.tostring(coreTrades), text_color = color.white, text_size = size.small)
    table.cell(chk, 0, 1, "Strategy trades closed", text_color = color.gray, text_size = size.small)
    table.cell(chk, 1, 1, str.tostring(strategy.closedtrades), text_color = color.white, text_size = size.small)
    table.cell(chk, 0, 2, "Should match (± same-bar stop/target ordering)", text_color = color.gray, text_size = size.tiny)
