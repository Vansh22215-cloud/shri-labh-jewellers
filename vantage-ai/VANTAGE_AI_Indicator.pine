//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// VANTAGE AI — NSE positional decision-support engine (long-only, daily). Research tool, not advice.
indicator("VANTAGE AI — NSE Positional Decision Engine", shorttitle = "VANTAGE AI", overlay = true,
     max_labels_count = 500, max_lines_count = 50, max_boxes_count = 50)
// ============================================================================================================
// ===== CORE BEGIN — identical in VANTAGE_AI_Indicator.pine and VANTAGE_AI_Strategy.pine (generated by build.py)
// ===== Edit src/core.pine and run build.py; never edit the core inside one output file only.
// ============================================================================================================

// ---------------------------------------------------------------------------------------------- 1 · INPUTS
G_CAP = "1 · Capital & risk"
capital     = input.float(50000, "Trading capital (₹)", minval = 1000, step = 1000, group = G_CAP,
     tooltip = "Your trading capital. Used only for the position-size calculator (not your broker balance).")
riskPct     = input.float(1.0, "Risk per trade (%)", minval = 0.1, maxval = 5, step = 0.1, group = G_CAP,
     tooltip = "Money you accept to lose if the stop-loss is hit, as % of capital. 1% is a common professional default.")
maxAllocPct = input.float(25, "Max capital per trade (%)", minval = 1, maxval = 100, step = 1, group = G_CAP,
     tooltip = "Never put more than this share of capital into one stock, even if the stop is very close.")

G_ENT = "2 · Entries"
useBreakout = input.bool(true, "Type 1: Breakout entries", group = G_ENT,
     tooltip = "Trend up + close above the highest high of the lookback period on above-average volume.")
usePullback = input.bool(true, "Type 2: Pullback entries", group = G_ENT,
     tooltip = "Strong uptrend + dip to the 20-EMA / demand zone on lighter volume + confirmed recovery candle.")
minScore    = input.int(70, "Minimum setup score for BUY", minval = 50, maxval = 100, group = G_ENT,
     tooltip = "A BUY also needs a valid setup and all safety filters. The score alone never creates a BUY.")
strongScore = input.int(80, "Strong-setup score", minval = 60, maxval = 100, group = G_ENT)
brkLen      = input.int(50, "Breakout lookback (bars)", minval = 10, maxval = 250, group = G_ENT,
     tooltip = "Resistance = highest high of the previous N bars (the current bar excluded).")
minRvol     = input.float(1.5, "Breakout volume (× 20-day average)", minval = 1.0, maxval = 5, step = 0.1, group = G_ENT)
maxExtAtr   = input.float(3.0, "Not extended: max distance above EMA20 (in ATR)", minval = 1, maxval = 10, step = 0.5,
     group = G_ENT, tooltip = "Blocks buying stocks that have already run far above their 20-EMA.")
minRoomR    = input.float(1.5, "Min room to overhead resistance (in R)", minval = 0, maxval = 10, step = 0.5,
     group = G_ENT, tooltip = "R = entry − stop. Needs this much room before the next resistance (52-week high or a " +
     "confirmed swing high). New 52-week highs have no overhead resistance.")
minGapBars  = input.int(5, "Min bars between an exit and the next BUY", minval = 0, maxval = 100, group = G_ENT)
maxStopPct  = input.float(15, "Skip if the stop is more than X% below entry", minval = 2, maxval = 50, group = G_ENT)

G_EXT = "3 · Exits"
exitMode    = input.string("Combined", "Exit mode", options = ["ATR trailing stop", "Fixed risk/reward", "Combined"],
     group = G_EXT, tooltip = "ATR trailing stop: protective + trailing stop only.  Fixed risk/reward: stop or Target 2.  " +
     "Combined (default): protective + trailing stop, plus an exit on confirmed bearish deterioration.")
atrLen      = input.int(14, "ATR length", minval = 5, maxval = 50, group = G_EXT)
stopMult    = input.float(3.0, "Initial stop (× ATR below entry)", minval = 0.5, maxval = 10, step = 0.25, group = G_EXT)
trailMult   = input.float(4.0, "Trailing stop (× ATR below the highest high since entry)", minval = 0.5, maxval = 10,
     step = 0.25, group = G_EXT, tooltip = "The stop only ever moves UP.")
t1R         = input.float(2.0, "Target 1 (× R)", minval = 0.5, maxval = 10, step = 0.5, group = G_EXT)
t2R         = input.float(3.0, "Target 2 (× R)", minval = 1.0, maxval = 20, step = 0.5, group = G_EXT)

G_MKT = "4 · Market & benchmark"
benchSym    = input.symbol("NSE:NIFTY", "Benchmark index", group = G_MKT,
     tooltip = "Used for relative strength and the market regime. NSE:NIFTY = NIFTY 50.")
useMarket   = input.bool(true, "Market filter: no fresh BUY when the benchmark is BEARISH", group = G_MKT)

G_STR = "5 · Structure"
swingLen    = input.int(5, "Swing length (bars on each side)", minval = 2, maxval = 20, group = G_STR,
     tooltip = "A swing high/low is confirmed only after this many later bars. It is never drawn or used earlier.")

G_W = "6 · Score weights (normalised to 100)"
wTrend = input.float(25, "Trend quality", minval = 0, group = G_W)
wMom   = input.float(20, "Momentum", minval = 0, group = G_W)
wStr   = input.float(20, "Market structure & price action", minval = 0, group = G_W)
wRS    = input.float(15, "Relative strength", minval = 0, group = G_W)
wVol   = input.float(10, "Volume confirmation", minval = 0, group = G_W)
wMkt   = input.float(10, "Market regime", minval = 0, group = G_W)

// ---------------------------------------------------------------------------------------------- 2 · BASE SERIES
atr     = ta.atr(atrLen)
ema20   = ta.ema(close, 20)
ema50   = ta.ema(close, 50)
ema200  = ta.ema(close, 200)
rsi     = ta.rsi(close, 14)
[macdLine, macdSig, hist] = ta.macd(close, 12, 26, 9)
[diPlus, diMinus, adx]    = ta.dmi(14, 14)
volAvg  = ta.sma(volume, 20)[1]                         // average of the 20 PREVIOUS bars
rvol    = volAvg > 0 ? volume / volAvg : na
hiPrior = ta.highest(high, brkLen)[1]                   // resistance: previous N bars, current bar excluded
hi252   = ta.highest(high, 252)[1]                      // 52-week high, current bar excluded

// Higher timeframe: ONLY the previous, fully completed weekly candle ([1] + lookahead_on = no repainting).
[wClose, wEma, wEmaPrev] = request.security(syminfo.tickerid, "W", [close[1], ta.ema(close, 20)[1], ta.ema(close, 20)[2]],
     lookahead = barmerge.lookahead_on)
weeklyKnown = not na(wEma) and not na(wEmaPrev)
weeklyUp    = weeklyKnown and wClose > wEma and wEma > wEmaPrev

// Benchmark (same timeframe, no lookahead). Missing / invalid symbol -> na -> modules fall back to neutral.
[bClose, bEma50, bEma200] = request.security(benchSym, timeframe.period, [close, ta.ema(close, 50), ta.ema(close, 200)],
     ignore_invalid_symbol = true)
benchOk = not na(bClose) and not na(bEma200) and bClose > 0

// ---------------------------------------------------------------------------------------------- 3 · RELATIVE STRENGTH
rs      = benchOk ? close / bClose : na
rsPerf  = rs / rs[63] - 1                               // 3-month performance vs the benchmark
rsSma   = ta.sma(rs, 50)
rsEma   = ta.ema(rs, 10)
rsKnown = not na(rsPerf) and not na(rsSma) and not na(rsEma[10])
rsOut   = rsKnown and rsPerf > 0 and rs > rsSma         // OUTPERFORMING
rsImproving = rsKnown and rsEma > rsEma[10]

// ---------------------------------------------------------------------------------------------- 4 · MARKET REGIME
mktBull   = benchOk and bClose > bEma200 and bEma50 > bEma200
mktBear   = benchOk and bClose < bEma200 and bEma50 < bEma200
mktRegime = not benchOk ? "N/A" : mktBull ? "BULLISH" : mktBear ? "BEARISH" : "SIDEWAYS"

// ---------------------------------------------------------------------------------------------- 5 · MARKET STRUCTURE
// Swings are confirmed swingLen bars later and only USED from that bar on (never back-dated).
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float swHi     = na
var float swHiPrev = na
var float swLo     = na
var float swLoPrev = na
var bool  hiTaken  = false
var bool  loTaken  = false
var int   structDir = 0                                  // 1 bullish, -1 bearish, 0 not yet known
var float dzTop = na                                     // "demand zone": last down candle before a bullish break
var float dzBot = na                                     // (an OHLC-derived zone, NOT actual institutional orders)
if not na(ph)
    swHiPrev := swHi
    swHi     := ph
    hiTaken  := false
if not na(pl)
    swLoPrev := swLo
    swLo     := pl
    loTaken  := false
bullBreak = not na(swHi) and not hiTaken and close > swHi
bearBreak = not na(swLo) and not loTaken and close < swLo
bullChoch = bullBreak and structDir == -1
bullBos   = bullBreak and structDir != -1
bearChoch = bearBreak and structDir == 1
bearBos   = bearBreak and structDir != 1
if bullBreak
    hiTaken   := true
    structDir := 1
    for i = 1 to 10
        if close[i] < open[i]
            dzTop := high[i]
            dzBot := low[i]
            break
if bearBreak
    loTaken   := true
    structDir := -1
if not na(dzBot) and close < dzBot
    dzTop := na
    dzBot := na
higherLow = not na(swLo) and not na(swLoPrev) and swLo > swLoPrev

// Failed breakout: a close back below a level broken in the last 3 bars.
var float brkLevel = na
var int   brkBar   = na
failedBreakout = not na(brkLevel) and bar_index - brkBar <= 3 and bar_index > brkBar and close < brkLevel
if failedBreakout or (not na(brkBar) and bar_index - brkBar > 3)
    brkLevel := na
    brkBar   := na
newBreak = close > hiPrior and close[1] <= hiPrior[1]
if newBreak
    brkLevel := hiPrior
    brkBar   := bar_index
recentFailed = nz(ta.barssince(failedBreakout), 999) <= 5

// Rejection: long upper wick into a resistance level, close back below it.
upperWick = high - math.max(open, close)
body      = math.abs(close - open)
nearRes   = (not na(swHi) and high >= swHi * 0.995 and close < swHi) or (not na(hi252) and high >= hi252 * 0.995 and close < hi252)
rejection = upperWick >= 2 * body and upperWick >= 0.5 * atr and nearRes

// ---------------------------------------------------------------------------------------------- 6 · SCORE (0-100)
// Each module is capped at its own weight, so correlated indicators inside one module cannot inflate the total.
ptTrend = (close > ema20 ? 5.0 : 0.0) + (ema20 > ema50 ? 5.0 : 0.0) + (ema50 > ema200 ? 5.0 : 0.0) +
     (ema50 > ema50[10] ? 2.5 : 0.0) + (ema200 > ema200[20] ? 2.5 : 0.0) + (weeklyKnown ? (weeklyUp ? 5.0 : 0.0) : 2.5)
ptMom = (rsi >= 50 and rsi <= 70 ? 8.0 : rsi > 70 and rsi <= 78 ? 4.0 : rsi >= 45 and rsi < 50 ? 3.0 : 0.0) +
     (hist > 0 and hist > hist[1] ? 6.0 : hist > 0 ? 4.0 : hist > hist[1] and hist[1] > hist[2] ? 2.0 : 0.0) +
     (adx >= 20 and diPlus > diMinus ? 6.0 : diPlus > diMinus ? 3.0 : 0.0)
ptStr = math.max(0.0, (structDir == 1 ? 8.0 : structDir == 0 ? 4.0 : 0.0) + (higherLow ? 6.0 : 0.0) +
     (nz(ta.barssince(bullBreak), 999) <= 15 ? 6.0 : 0.0) - (recentFailed ? 6.0 : 0.0) - (rejection ? 4.0 : 0.0))
ptRS = rsKnown ? (rsPerf > 0 ? 5.0 : 0.0) + (rs > rsSma ? 5.0 : 0.0) + (rsImproving ? 5.0 : 0.0) : 7.5
upVol   = math.sum(close > close[1] ? volume : 0.0, 20)
dnVol   = math.sum(close < close[1] ? volume : 0.0, 20)
accRatio = dnVol > 0 ? upVol / dnVol : 2.0
riseWeak = close > close[10] and ta.sma(volume, 10) < 0.8 * ta.sma(volume, 50)
ptVol = math.max(0.0, (accRatio >= 1.2 ? 5.0 : accRatio >= 1.0 ? 2.5 : 0.0) +
     (close > close[1] and nz(rvol) >= 1.5 ? 5.0 : close > close[1] and nz(rvol) < 0.7 ? 0.0 : 2.5) - (riseWeak ? 2.5 : 0.0))
ptMkt = benchOk ? (bClose > bEma200 ? 5.0 : 0.0) + (bEma50 > bEma200 ? 5.0 : 0.0) : 5.0

wSum  = wTrend + wMom + wStr + wRS + wVol + wMkt
wNorm = wSum > 0 ? 100.0 / wSum : 0.0
score = math.round((wTrend * ptTrend / 25 + wMom * ptMom / 20 + wStr * ptStr / 20 + wRS * ptRS / 15 +
     wVol * ptVol / 10 + wMkt * ptMkt / 10) * wNorm)

// ---------------------------------------------------------------------------------------------- 7 · SETUPS
trendOk = close > ema200 and ema50 > ema200 and close > ema50
rsOkBrk = not rsKnown or rsPerf > 0 or rs > rsSma
rsOkPb  = not rsKnown or rs > rsSma
breakoutSetup = useBreakout and trendOk and newBreak and nz(rvol) >= minRvol and (hist > 0 or rsi > 55) and rsOkBrk
stackUp  = ema20 > ema50 and ema50 > ema200 and ema50 > ema50[10]
touched  = ta.lowest(low, 5) <= ema20 * 1.005 or (not na(dzTop) and ta.lowest(low, 5) <= dzTop and close > dzBot)
held     = ta.lowest(close, 5) >= ema50 * 0.98
rsiCool  = ta.lowest(rsi, 5) <= 55 and ta.lowest(rsi, 5) >= 38
volDry   = ta.sma(volume, 3)[1] < volAvg
recovery = close > high[1] and close > open and close > ema20
pullbackSetup = usePullback and stackUp and touched and held and rsiCool and volDry and recovery and rsOkPb

// ---------------------------------------------------------------------------------------------- 8 · RISK & FILTERS
planStop = close - stopMult * atr
riskPS   = close - planStop
stopOk   = riskPS > 0 and riskPS / close * 100 <= maxStopPct
float overhead = na
if not na(hi252) and close < hi252
    overhead := hi252
if not na(swHi) and swHi > close
    overhead := na(overhead) ? swHi : math.min(overhead, swHi)
roomOk      = na(overhead) or overhead - close >= minRoomR * riskPS
notExtended = close - ema20 <= maxExtAtr * atr and rsi <= 80
mktOk       = not useMarket or not mktBear
riskAmt  = capital * riskPct / 100
qtyRisk  = riskPS > 0 ? math.floor(riskAmt / riskPS) : 0
qtyCap   = close > 0 ? math.floor(capital * maxAllocPct / 100 / close) : 0
qtyCalc  = math.min(qtyRisk, qtyCap)
warm     = bar_index >= 260 and not na(ema200) and not na(atr)

// ---------------------------------------------------------------------------------------------- 9 · POSITION STATE
// One simulated long position. Everything below changes ONLY on confirmed (closed) bars.
var bool   inPos        = false
var bool   pendingEntry = false
var bool   pendingExit  = false
var string pendingWhy   = ""
var string setupType    = ""
var float  planEntry    = na
var float  entryPx      = na
var float  initStop     = na
var float  stopLvl      = na
var float  tgt1         = na
var float  tgt2         = na
var float  hiSince      = na
var int    entryBar     = na
var int    lastExitBar  = -100000
var int    posQty       = 0
var int    entryScore   = 0
var bool   t1Done       = false
var bool   t2Done       = false
var bool   slWarned     = false
buyNow   = false
sellNow  = false                     // a SELL decision was made on this bar
string sellWhy = ""
exitFill = false                     // the position was closed during this bar (stop/target) or at its open
float exitPx = na
t1Event  = false
t2Event  = false
slWarnEvent = false
if barstate.isconfirmed and warm
    // a) exit decided on the previous bar -> filled at this bar's open
    if inPos and pendingExit
        inPos       := false
        pendingExit := false
        exitFill    := true
        exitPx      := open
        lastExitBar := bar_index
    // b) entry decided on the previous bar -> filled at this bar's open
    if pendingEntry
        pendingEntry := false
        inPos    := true
        entryPx  := open
        entryBar := bar_index
        hiSince  := high
        t1Done   := false
        t2Done   := false
        slWarned := false
    // c) protective / trailing stop and fixed target inside this bar (stop checked first: conservative)
    if inPos
        if low <= stopLvl
            inPos       := false
            exitFill    := true
            exitPx      := math.min(open, stopLvl)
            sellNow     := true
            sellWhy     := stopLvl > initStop ? "Trailing stop" : "Stop-loss"
            lastExitBar := bar_index
        else if exitMode == "Fixed risk/reward" and high >= tgt2
            inPos       := false
            exitFill    := true
            exitPx      := math.max(open, tgt2)
            sellNow     := true
            sellWhy     := "Target 2"
            lastExitBar := bar_index
    // d) still in the position: target events, trailing stop (only up), bearish deterioration
    if inPos
        if not t1Done and high >= tgt1
            t1Done  := true
            t1Event := true
        if not t2Done and high >= tgt2
            t2Done  := true
            t2Event := true
        hiSince := math.max(hiSince, high)
        if exitMode != "Fixed risk/reward"
            stopLvl := math.max(stopLvl, hiSince - trailMult * atr)
        if not slWarned and close <= stopLvl + 0.5 * atr
            slWarned    := true
            slWarnEvent := true
        if exitMode == "Combined"
            string why = ""
            if close < ema50 and hist < 0
                why := "Trend deterioration (below EMA50, MACD negative)"
            else if bearChoch
                why := "Bearish structure change (CHoCH)"
            else if bearBos and close < ema20
                why := "Support breakdown (bearish BOS)"
            else if failedBreakout and bar_index - entryBar <= 5
                why := "Failed breakout"
            if why != ""
                pendingExit := true
                pendingWhy  := why
                sellNow     := true
                sellWhy     := why
    // e) new BUY (decided at the close, filled at the next open)
    gapOk = bar_index - lastExitBar >= minGapBars
    if not inPos and not pendingEntry and gapOk and (breakoutSetup or pullbackSetup) and notExtended and stopOk and
         roomOk and mktOk and not rejection and score >= minScore and qtyCalc >= 1
        pendingEntry := true
        buyNow       := true
        setupType    := breakoutSetup ? "Breakout" : "Pullback"
        planEntry    := close
        initStop     := planStop
        stopLvl      := planStop
        tgt1         := close + t1R * riskPS
        tgt2         := close + t2R * riskPS
        posQty       := qtyCalc
        entryScore   := int(score)
// ============================================================================================================
// ===== CORE END
// ============================================================================================================

// ---------------------------------------------------------------------------------------------- 10 · DISPLAY (indicator only)
G_VIS = "7 · Display"
showLevels  = input.bool(true,  "Show entry / stop / targets while in a trade", group = G_VIS)
showSR      = input.bool(true,  "Show support / resistance (confirmed swings)", group = G_VIS)
showStruct  = input.bool(false, "Show BOS / CHoCH markers", group = G_VIS)
showZone    = input.bool(false, "Show demand zone (OHLC-derived)", group = G_VIS)
showDash    = input.bool(true,  "Show dashboard", group = G_VIS)
dashSize    = input.string("Small", "Dashboard text size", options = ["Tiny", "Small", "Normal"], group = G_VIS)

// BUY / SELL: unmistakable, one marker per decision, placed on the bar where the decision was made (never earlier)
plotshape(buyNow,  "BUY arrow",  shape.triangleup,   location.belowbar, color.new(#00C853, 0), size = size.small)
plotshape(sellNow, "SELL arrow", shape.triangledown, location.abovebar, color.new(#FF1744, 0), size = size.small)
if buyNow
    label.new(bar_index, low - 0.5 * atr, "BUY\n" + setupType + "\nScore " + str.tostring(entryScore) + "/100",
         style = label.style_label_up, color = color.new(#00C853, 0), textcolor = color.white, size = size.small)
if sellNow
    label.new(bar_index, high + 0.5 * atr, "SELL\n" + sellWhy, style = label.style_label_down,
         color = color.new(#FF1744, 0), textcolor = color.white, size = size.small)

// Trade levels only while a position is open (breaks between trades, no clutter)
showTrade = showLevels and inPos
plot(showTrade ? entryPx : na, "Entry",          color.new(color.blue, 0),    1, plot.style_linebr)
plot(showTrade ? stopLvl : na, "Stop / trailing", color.new(#FF1744, 0),      2, plot.style_linebr)
plot(showTrade ? tgt1 : na,    "Target 1",       color.new(#00C853, 40),     1, plot.style_linebr)
plot(showTrade ? tgt2 : na,    "Target 2",       color.new(#00C853, 0),      1, plot.style_linebr)
plot(showSR ? swHi : na, "Resistance (last swing high)", color.new(color.orange, 55), 1, plot.style_stepline)
plot(showSR ? swLo : na, "Support (last swing low)",     color.new(color.teal, 55),   1, plot.style_stepline)
plotshape(showStruct and bullBos,   "Bullish BOS",   shape.circle, location.belowbar, color.new(color.green, 40), size = size.tiny)
plotshape(showStruct and bullChoch, "Bullish CHoCH", shape.diamond, location.belowbar, color.new(color.green, 0), size = size.tiny)
plotshape(showStruct and bearBos,   "Bearish BOS",   shape.circle, location.abovebar, color.new(color.red, 40), size = size.tiny)
plotshape(showStruct and bearChoch, "Bearish CHoCH", shape.diamond, location.abovebar, color.new(color.red, 0), size = size.tiny)
plot(showZone ? dzTop : na, "Demand zone top",    color.new(color.green, 70), 1, plot.style_linebr)
plot(showZone ? dzBot : na, "Demand zone bottom", color.new(color.green, 70), 1, plot.style_linebr)

// ---------------------------------------------------------------------------------------------- 11 · DASHBOARD
txtSize = dashSize == "Tiny" ? size.tiny : dashSize == "Normal" ? size.normal : size.small
var table dash = table.new(position.top_right, 2, 24, bgcolor = color.new(#0D1117, 5), border_color = color.new(#30363D, 0),
     border_width = 1, frame_color = color.new(#30363D, 0), frame_width = 1)
cGood = color.new(#00E676, 0)
cBad  = color.new(#FF5252, 0)
cMid  = color.new(#FFD740, 0)
cTxt  = color.new(#E6EDF3, 0)
cDim  = color.new(#8B949E, 0)

dRow(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color = cDim, text_size = txtSize, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = c, text_size = txtSize, text_halign = text.align_right)

stockTrend = close > ema50 and ema50 > ema200 ? "BULLISH" : close < ema50 and ema50 < ema200 ? "BEARISH" : "SIDEWAYS"
status = buyNow ? "BUY (next open)" : sellNow ? "SELL (exit)" : inPos ? "HOLD" : score >= minScore ? "WAIT – no trigger yet" :
     score >= 50 ? "WAIT" : "WAIT – avoid fresh entry"
statusCol = buyNow ? cGood : sellNow ? cBad : inPos ? cGood : score >= minScore ? cMid : score >= 50 ? cTxt : cBad
f(x) => "₹" + str.tostring(x, format.mintick)

if showDash and barstate.islast
    table.clear(dash, 0, 0, 1, 23)
    table.cell(dash, 0, 0, "VANTAGE AI", text_color = color.new(#58A6FF, 0), text_size = txtSize, text_halign = text.align_left)
    table.cell(dash, 1, 0, "NSE positional · long-only", text_color = cDim, text_size = txtSize, text_halign = text.align_right)
    dRow(1, "Stock", syminfo.ticker, cTxt)
    dRow(2, "Timeframe", timeframe.period, timeframe.isdaily ? cTxt : cMid)
    dRow(3, "Market regime", mktRegime, mktRegime == "BULLISH" ? cGood : mktRegime == "BEARISH" ? cBad : cMid)
    dRow(4, "Stock trend", stockTrend, stockTrend == "BULLISH" ? cGood : stockTrend == "BEARISH" ? cBad : cMid)
    dRow(5, "Momentum", ptMom >= 12 ? "STRONG" : "WEAK", ptMom >= 12 ? cGood : cBad)
    dRow(6, "Relative strength", not rsKnown ? "N/A" : rsOut ? "OUTPERFORMING" : "UNDERPERFORMING", not rsKnown ? cDim : rsOut ? cGood : cBad)
    dRow(7, "Volume", ptVol >= 6 ? "CONFIRMED" : "WEAK", ptVol >= 6 ? cGood : cBad)
    dRow(8, "Market structure", structDir == 1 ? "BULLISH" : structDir == -1 ? "BEARISH" : "NEUTRAL",
         structDir == 1 ? cGood : structDir == -1 ? cBad : cMid)
    dRow(9, "Setup score", str.tostring(score) + "/100", score >= strongScore ? cGood : score >= minScore ? cMid : score >= 50 ? cTxt : cBad)
    dRow(10, "  why", "Trend " + str.tostring(ptTrend, "#.#") + "/25 · Mom " + str.tostring(ptMom, "#") + "/20 · Str " +
         str.tostring(ptStr, "#") + "/20", cDim)
    dRow(11, "", "RS " + str.tostring(ptRS, "#.#") + "/15 · Vol " + str.tostring(ptVol, "#.#") + "/10 · Mkt " +
         str.tostring(ptMkt, "#") + "/10", cDim)
    dRow(12, "Trade status", status, statusCol)
    r = 13
    if inPos or pendingEntry
        dRow(r,     "Entry",  inPos ? f(entryPx) : "next open ≈ " + f(planEntry), cTxt)
        dRow(r + 1, "Stop-loss (initial)", f(initStop), cBad)
        dRow(r + 2, "Stop now (trailing)", f(stopLvl), cBad)
        dRow(r + 3, "Target 1 / 2", f(tgt1) + " / " + f(tgt2), cGood)
        dRow(r + 4, "Quantity", str.tostring(posQty) + " shares", cTxt)
        dRow(r + 5, "Risk", "₹" + str.tostring(posQty * (planEntry - initStop), "#,###") + " (" + str.tostring(riskPct) + "%)", cMid)
        if inPos
            pnl = (close / entryPx - 1) * 100
            dRow(r + 6, "Unrealised P/L", str.tostring(pnl, "+#.##;-#.##") + "%", pnl >= 0 ? cGood : cBad)
        r := r + 7
    else
        // calculator for a BUY at today's close with the system's stop (what a trade would look like now)
        inv = qtyCalc * close
        dRow(r,     "If bought now", qtyCalc >= 1 ? str.tostring(qtyCalc) + " sh · " + f(inv) : "size < 1 share", cDim)
        dRow(r + 1, "Stop / max loss", f(planStop) + " / ₹" + str.tostring(qtyCalc * riskPS, "#,###"), cDim)
        dRow(r + 2, "Reward to T2 · R:R", "₹" + str.tostring(qtyCalc * t2R * riskPS, "#,###") + " · 1:" + str.tostring(t2R), cDim)
        r := r + 3
    if not chart.is_standard
        dRow(r, "⚠ Chart type", "Use standard candles – signals invalid", cBad)
        r += 1
    if not timeframe.isdaily
        dRow(r, "⚠ Timeframe", "Designed and tested for 1D", cMid)
        r += 1
    if not benchOk
        dRow(r, "⚠ Benchmark", "No data – RS/market neutral", cMid)
        r += 1
    dRow(r, "Note", "Score = confluence, not a probability", cDim)

// ---------------------------------------------------------------------------------------------- 12 · ALERTS
// alertcondition: pick one condition per alert in the TradingView dialog ("Once per bar close").
strongSetup = score >= strongScore and score[1] < strongScore and trendOk and not inPos
bearDeterioration = bearChoch or ta.crossunder(close, ema200)
alertcondition(buyNow,            "1 · VANTAGE BUY",           "VANTAGE AI BUY {{ticker}} {{interval}} close {{close}} – buy at next open")
alertcondition(sellNow,           "2 · VANTAGE SELL",          "VANTAGE AI SELL (exit long) {{ticker}} {{interval}} close {{close}}")
alertcondition(slWarnEvent,       "3 · Stop-loss warning",     "VANTAGE AI stop-loss warning {{ticker}}: price within 0.5 ATR of the stop")
alertcondition(t1Event,           "4 · Target 1 reached",      "VANTAGE AI Target 1 reached {{ticker}} {{interval}}")
alertcondition(t2Event,           "5 · Target 2 reached",      "VANTAGE AI Target 2 reached {{ticker}} {{interval}}")
alertcondition(strongSetup,       "6 · Strong bullish setup",  "VANTAGE AI strong bullish setup forming {{ticker}} (score >= strong level) – no trigger yet")
alertcondition(bearDeterioration, "7 · Bearish deterioration", "VANTAGE AI bearish deterioration {{ticker}} (CHoCH or close below EMA200)")

// One detailed alert with all numbers: create an alert with "Any alert() function call" (fires once per bar close).
if barstate.isconfirmed
    head = syminfo.ticker + " " + timeframe.period + " · close " + str.tostring(close, format.mintick) + " · score " + str.tostring(score)
    if buyNow
        alert("VANTAGE AI BUY (" + setupType + ") " + head + " · buy next open ≈" + str.tostring(planEntry, format.mintick) +
             " · stop " + str.tostring(initStop, format.mintick) + " · T1 " + str.tostring(tgt1, format.mintick) + " · T2 " +
             str.tostring(tgt2, format.mintick) + " · qty " + str.tostring(posQty) + " · risk ₹" +
             str.tostring(posQty * (planEntry - initStop), "#,###"), alert.freq_once_per_bar_close)
    if sellNow
        alert("VANTAGE AI SELL (exit long) " + head + " · reason: " + sellWhy, alert.freq_once_per_bar_close)
    if slWarnEvent
        alert("VANTAGE AI stop-loss warning " + head + " · stop " + str.tostring(stopLvl, format.mintick), alert.freq_once_per_bar_close)
    if t1Event
        alert("VANTAGE AI Target 1 reached " + head + " · T1 " + str.tostring(tgt1, format.mintick), alert.freq_once_per_bar_close)
    if t2Event
        alert("VANTAGE AI Target 2 reached " + head + " · T2 " + str.tostring(tgt2, format.mintick), alert.freq_once_per_bar_close)
    if strongSetup
        alert("VANTAGE AI strong bullish setup " + head, alert.freq_once_per_bar_close)
    if bearDeterioration
        alert("VANTAGE AI bearish deterioration " + head, alert.freq_once_per_bar_close)
